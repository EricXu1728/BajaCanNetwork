// Basic CAN Receiver Example

#include <mcp_can.h>
#include <SPI.h>

#define CAN0_INT 2      // MCP2515 INT pin
#define CAN0_CS 10      // MCP2515 CS pin

MCP_CAN CAN0(CAN0_CS);

long unsigned int rxId;
unsigned char len = 0;
unsigned char rxBuf[8];

void setup() {
  Serial.begin(115200);
  delay(1000);

  // Change MCP_16MHZ to MCP_8MHZ if your MCP2515 crystal says 8.000
  if (CAN0.begin(MCP_ANY, CAN_500KBPS, MCP_16MHZ) == CAN_OK) {
    Serial.println("MCP2515 Initialized Successfully!");
  } else {
    Serial.println("Error Initializing MCP2515...");
    while (1);
  }

  CAN0.setMode(MCP_NORMAL);

  pinMode(CAN0_INT, INPUT);

  Serial.println("Basic CAN Receiver Ready...");
}

void loop() {
  if (!digitalRead(CAN0_INT)) {
    CAN0.readMsgBuf(&rxId, &len, rxBuf);

    Serial.print("ID: 0x");
    Serial.print(rxId, HEX);

    Serial.print("  DLC: ");
    Serial.print(len);

    Serial.print("  Data:");

    for (byte i = 0; i < len; i++) {
      Serial.print(" 0x");
      if (rxBuf[i] < 0x10) Serial.print("0");
      Serial.print(rxBuf[i], HEX);
    }

    Serial.println();

    // Optional: only process messages from sender ID 0x100
    if (rxId == 0x100 && len == 8) {
      Serial.println("Received expected 8-byte message from ID 0x100");
    }
  }
}
